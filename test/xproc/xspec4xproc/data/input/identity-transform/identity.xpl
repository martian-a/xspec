<?xml version="1.0" encoding="UTF-8"?>
<p:declare-step 
	xmlns:p="http://www.w3.org/ns/xproc"
	xmlns:xpc="http://xspec.io/ns/xproc"
	version="3.1"
	type="xpc:identity" 
	name="identity">
	
	<p:input port="source" sequence="true" content-types="any"/>
	<p:output port="result" sequence="true" content-types="any"/>
	
	<p:identity />
	
</p:declare-step>